{
  "name": "499apps-games",
  "version": "0.1.0",
  "private": true,
  "description": "499apps Games hub: the /games/ page, the parents' privacy page, the plan and the site assembly.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "icons": "node src/kit/scripts/gen-icons.mjs --variant hub --out public/icons --favicon public/favicon.svg",
    "build": "node src/kit/scripts/gen-icons.mjs --variant hub --out public/icons --favicon public/favicon.svg && vite build && node src/kit/scripts/gen-precache.mjs --dist dist --base /games/",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "scan:secrets": "node src/kit/scripts/scan-secrets.mjs",
    "e2e": "node src/kit/scripts/run-e2e.mjs --config playwright.config.ts --server preview --port 4173 --ready-path /games/",
    "smoke": "pnpm run e2e",
    "e2e:update": "playwright test --config playwright.config.ts --update-snapshots",
    "ci:local": "node src/kit/scripts/ci-local.mjs",
    "kit:sync": "node scripts/kit-sync.mjs",
    "assemble": "node scripts/assemble.mjs",
    "assemble:lock": "node scripts/assemble-lock.mjs",
    "site:serve": "node src/kit/scripts/static-server.mjs --root site --port 4499",
    "e2e:site": "node src/kit/scripts/run-e2e.mjs --config playwright.site.config.ts --server site --root site --port 4499 --ready-path /games/",
    "e2e:site:update": "playwright test --config playwright.site.config.ts --update-snapshots",
    "ci:site": "node scripts/ci-site.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.13.0",
    "@types/three": "^0.170.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "fast-check": "^3.23.1",
    "globals": "^15.14.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
